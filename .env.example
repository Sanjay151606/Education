# =============================================================================
# BRAIN GRAPH ENVIRONMENT CONFIGURATION
# =============================================================================

# AI & LLM API Key (Backend only)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Configuration
# Connect your existing Supabase project:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server-Side Only Service Key (NEVER expose to client/frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# Application Base URL
NEXT_PUBLIC_API_URL=http://localhost:5001
